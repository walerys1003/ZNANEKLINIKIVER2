# ─── ChirurgiaPiekna.com · Tier 3 integrations ─────────────────────────
# All variables are OPTIONAL. The app runs end-to-end in demo mode without
# any of them. Configure to unlock the real production integrations.

# ─── Stripe ─────────────────────────────────────────────────────────────
# Publishable key — exposed to the browser, used by Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Secret key — server-only, used by /api/checkout/create-payment-intent.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ─── Mapbox GL ──────────────────────────────────────────────────────────
# Public access token. When set + pins have lng/lat, LuxuryMap switches
# from the SVG mock to the real Mapbox GL renderer (pan/zoom/satellite).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoiy...
# Optional custom style URL (cream + champagne luxury palette).
# Default: mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# ─── WebRTC signaling ───────────────────────────────────────────────────
# Socket.IO server URL. When set, /telekonsultacje/[id] switches from
# in-page loopback mode to real peer-to-peer over the network.
# Implementation: see src/lib/webrtc/useWebRTC.ts (mode='signaling').
NEXT_PUBLIC_SIGNALING_URL=wss://signaling.chirurgiapiekna.com

# ─── TensorFlow.js ──────────────────────────────────────────────────────
# No env vars needed. MediaPipe FaceMesh model is downloaded from
# tfhub on first /ai-analiza visit (~3 MB, cached by the browser).
